<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF5500</item>
        <item name="android:navigationBarColor">#111315</item>
        <item name="android:statusBarColor">#111315</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#111315</item>
        <item name="android:buttonStyle">@style/TegashButton</item>
        <item name="android:alertDialogTheme">@style/TegashDialog</item>
    </style>
    <style name="TegashButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="TegashDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:colorAccent">#FF7037</item>
        <item name="android:windowMinWidthMajor">87%</item>
        <item name="android:windowMinWidthMinor">87%</item>
    </style>
    <style name="AppThemeBlue" parent="AppTheme"><item name="android:colorAccent">#67B7FF</item></style>
    <style name="AppThemeGreen" parent="AppTheme"><item name="android:colorAccent">#81C995</item></style>
    <style name="AppThemePurple" parent="AppTheme"><item name="android:colorAccent">#CF9FFF</item></style>
    <style name="AppThemePink" parent="AppTheme"><item name="android:colorAccent">#FF91B9</item></style>
    <style name="ExportDialogTheme" parent="AppTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
    <style name="ExportDialogBlue" parent="ExportDialogTheme"><item name="android:colorAccent">#67B7FF</item></style>
    <style name="ExportDialogGreen" parent="ExportDialogTheme"><item name="android:colorAccent">#81C995</item></style>
    <style name="ExportDialogPurple" parent="ExportDialogTheme"><item name="android:colorAccent">#CF9FFF</item></style>
    <style name="ExportDialogPink" parent="ExportDialogTheme"><item name="android:colorAccent">#FF91B9</item></style>
</resources>
